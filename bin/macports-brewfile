#!/bin/sh
set -eu

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
repo_dir="$(CDPATH='' cd -- "$script_dir/.." && pwd)"
map_file="$repo_dir/maps/default.tsv"
port_bin="${MACPORTS_BREWFILE_PORT_BIN:-/opt/local/bin/port}"
sudo_bin="${MACPORTS_BREWFILE_SUDO_BIN:-sudo}"
dry_run=false
state_dir=
unresolved_file=
gui_file=
install_output_file=
command_status_file=
notes_file=
sudo_refresh_pid=
sudo_refresh_sleep_file=
sudo_session_started=false

log() {
  printf '%s\n' "$*"
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  macports-brewfile install [--dry-run] BREWFILE...
  macports-brewfile refresh-fallbacks [--dry-run]
  macports-brewfile update [--dry-run]

Install Brewfile CLI declarations, refresh fallback releases, or update MacPorts.
EOF
}

cleanup() {
  if [ -n "$sudo_refresh_sleep_file" ] && [ -s "$sudo_refresh_sleep_file" ]; then
    IFS= read -r sudo_refresh_sleep_pid <"$sudo_refresh_sleep_file" || true
    if [ -n "${sudo_refresh_sleep_pid:-}" ]; then
      kill "$sudo_refresh_sleep_pid" 2>/dev/null || true
    fi
  fi

  if [ -n "$sudo_refresh_pid" ]; then
    kill "$sudo_refresh_pid" 2>/dev/null || true
    wait "$sudo_refresh_pid" 2>/dev/null || true
  fi

  if [ -n "$state_dir" ]; then
    rm -rf "$state_dir"
  fi
}

record_unresolved() {
  printf '%s\t%s\n' "$1" "$2" >>"$unresolved_file"
}

record_gui() {
  printf '%s\n' "$1" >>"$gui_file"
}

extract_brew_items() {
  sed -nE 's/^[[:space:]]*brew[[:space:]]+"([^"]+)".*/\1/p' "$1"
}

extract_cask_items() {
  sed -nE 's/^[[:space:]]*cask[[:space:]]+"([^"]+)".*/\1/p' "$1"
}

extract_mas_ids() {
  sed -nE 's/^[[:space:]]*mas[[:space:]]+"[^"]+",[[:space:]]*id:[[:space:]]*([0-9]+).*/\1/p' "$1"
}

validate_map() {
  [ -f "$map_file" ] || die "Mapping file is missing: $map_file"

  if ! awk -F '\t' '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    NF != 5 { exit 1 }
    $1 !~ /^(brew|cask)$/ || $2 == "" { exit 1 }
    $3 !~ /^(port|fallback|fallback-root|skip)$/ { exit 1 }
    $3 == "port" && ($4 == "" || $4 == "-") { exit 1 }
    $3 ~ /^fallback(-root)?$/ && ($4 !~ /^fallbacks\/[A-Za-z0-9._\/-]+\.sh$/ || $4 ~ /(^|\/)\.\.?($|\/)/) { exit 1 }
    $3 == "skip" && $4 != "-" { exit 1 }
    seen[$1 SUBSEP $2]++ { exit 1 }
  ' "$map_file"; then
    die "Invalid mapping file: $map_file"
  fi
}

map_field() {
  kind="$1"
  token="$2"
  field="$3"

  awk -F '\t' -v kind="$kind" -v token="$token" -v field="$field" '
    $1 == kind && $2 == token {
      print $field
      exit
    }
  ' "$map_file"
}

capture_command() {
  label="$1"
  shift

  printf '\n===== %s =====\n' "$label" >>"$install_output_file"
  : >"$command_status_file"

  (
    set +e
    "$@"
    status=$?
    printf '%s\n' "$status" >"$command_status_file"
    exit 0
  ) 2>&1 | tee -a "$install_output_file"

  status="$(cat "$command_status_file")"
  [ "$status" -eq 0 ]
}

run_privileged_port() {
  capture_command "$sudo_bin -n $port_bin $*" "$sudo_bin" -n "$port_bin" "$@"
}

keep_sudo_alive() {
  while :; do
    sleep 60 &
    sudo_refresh_sleep_pid=$!
    printf '%s\n' "$sudo_refresh_sleep_pid" >"$sudo_refresh_sleep_file"
    wait "$sudo_refresh_sleep_pid" || exit 0
    : >"$sudo_refresh_sleep_file"
    "$sudo_bin" -n -v || exit 0
  done
}

start_sudo_session() {
  if "$sudo_session_started"; then
    return 0
  fi

  log "Requesting administrator access for MacPorts..."
  "$sudo_bin" -v
  keep_sudo_alive &
  sudo_refresh_pid=$!
  while [ ! -s "$sudo_refresh_sleep_file" ]; do
    if ! kill -0 "$sudo_refresh_pid" 2>/dev/null; then
      die "Could not start the MacPorts sudo credential refresher."
    fi
    sleep 1
  done
  sudo_session_started=true
}

install_macports_target() {
  source_token="$1"
  target="$2"

  if "$dry_run"; then
    log "Would install MacPorts port $target (for $source_token)"
    return 0
  fi

  log "Installing MacPorts port $target (for $source_token)"
  if ! run_privileged_port install "$target"; then
    record_unresolved "$source_token" "MacPorts install failed: $target"
  fi
}

run_macports_item() {
  kind="$1"
  token="$2"
  action="$(map_field "$kind" "$token" 3)"
  target="$(map_field "$kind" "$token" 4)"
  note="$(map_field "$kind" "$token" 5)"

  if [ -z "$action" ]; then
    if [ "$kind" = brew ]; then
      install_macports_target "$token" "$token"
    fi
    return 0
  fi

  case "$action" in
  port)
    install_macports_target "$token" "$target"
    ;;
  fallback | fallback-root)
    fallback_path="$repo_dir/$target"
    if [ ! -f "$fallback_path" ]; then
      record_unresolved "$token" "Missing MacPorts fallback: $target"
      return 0
    fi

    if "$dry_run"; then
      log "Would run reviewed fallback for $token: $note"
      return 0
    fi

    if [ "$action" = fallback-root ]; then
      start_sudo_session
    fi

    log "Running reviewed fallback for $token: $note"
    if ! capture_command "fallback $token" \
      env MACPORTS_BREWFILE_PORT_BIN="$port_bin" \
      MACPORTS_BREWFILE_SUDO_BIN="$sudo_bin" \
      sh "$fallback_path"; then
      record_unresolved "$token" "Fallback failed: $note"
    fi
    ;;
  skip)
    record_unresolved "$token" "$note"
    ;;
  esac
}

run_macports_brewfile() {
  extract_brew_items "$1" | while IFS= read -r token; do
    if [ -n "$token" ]; then
      run_macports_item brew "$token"
    fi
  done
}

run_macports_cask_mappings() {
  extract_cask_items "$1" | while IFS= read -r token; do
    action="$(map_field cask "$token" 3)"
    if [ -n "$action" ]; then
      run_macports_item cask "$token"
    fi
  done
}

run_mas_installs() {
  brewfile="$1"

  if "$dry_run"; then
    extract_mas_ids "$brewfile" | while IFS= read -r app_id; do
      log "Would install Mac App Store app $app_id"
    done
    return 0
  fi

  if ! command -v mas >/dev/null 2>&1; then
    record_gui "Mac App Store installs skipped because mas is unavailable."
    return 0
  fi

  if ! mas account >/dev/null 2>&1; then
    record_gui "Mac App Store installs skipped; sign in to the App Store, then rerun macports-brewfile."
    return 0
  fi

  extract_mas_ids "$brewfile" | while IFS= read -r app_id; do
    if ! mas install "$app_id"; then
      record_gui "Mac App Store install failed for id $app_id."
    fi
  done
}

report_manual_casks() {
  brewfile="$1"

  while IFS= read -r line; do
    token="$(printf '%s\n' "$line" | sed -nE 's/^[[:space:]]*cask[[:space:]]+"([^"]+)".*/\1/p')"
    [ -n "$token" ] || continue

    action="$(map_field cask "$token" 3)"
    if [ "$action" = port ] || [ "$action" = fallback ]; then
      log "MacPorts handles cask $token."
      continue
    fi

    destination="$HOME/Applications"
    case "$line" in
    *'appdir: "/Applications"'*) destination=/Applications ;;
    esac
    record_gui "Install cask $token manually in $destination."
  done <"$brewfile"
}

run_brewfile() {
  brewfile="$1"
  run_macports_brewfile "$brewfile"
  run_macports_cask_mappings "$brewfile"
  run_mas_installs "$brewfile"
  report_manual_casks "$brewfile"
}

run_all_fallbacks() {
  awk -F '\t' '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    $3 ~ /^fallback(-root)?$/ { print $1 "\t" $2 }
  ' "$map_file" | while IFS="$(printf '\t')" read -r kind token; do
    run_macports_item "$kind" "$token"
  done
}

print_summary() {
  if [ -s "$unresolved_file" ]; then
    log "Unresolved packages:"
    sed 's/\t/: /' "$unresolved_file"
  fi

  if [ -s "$gui_file" ]; then
    log "GUI follow-up:"
    cat "$gui_file"
  fi
}

print_install_notes() {
  awk '
    /^===== / { label = $0; in_notes = 0; next }
    /^[[:space:]]*--->  Some of the ports you installed have notes:/ {
      in_notes = 1
      printed_label = 0
      next
    }
    in_notes {
      if (!printed_label) {
        print label
        printed_label = 1
      }
      print
    }
  ' "$install_output_file" >"$notes_file"

  if [ -s "$notes_file" ]; then
    log "MacPorts installation notes:"
    cat "$notes_file"
  fi
}

[ "$#" -gt 0 ] || {
  usage >&2
  exit 1
}

command_name="$1"
shift

case "$command_name" in
install | refresh-fallbacks | update) ;;
*)
  usage >&2
  exit 1
  ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
  --dry-run)
    dry_run=true
    shift
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  --*)
    die "Unknown option: $1"
    ;;
  *)
    break
    ;;
  esac
done

case "$command_name" in
install)
  [ "$#" -gt 0 ] || die "At least one Brewfile is required."
  for brewfile in "$@"; do
    [ -f "$brewfile" ] || die "Brewfile does not exist: $brewfile"
  done
  ;;
refresh-fallbacks | update)
  [ "$#" -eq 0 ] || die "$command_name does not accept Brewfiles."
  ;;
esac

validate_map

requires_macports=false
case "$command_name" in
install | update) requires_macports=true ;;
esac

if "$requires_macports" && [ ! -x "$port_bin" ]; then
  if "$dry_run"; then
    log "MacPorts would be required at $port_bin."
  else
    die "MacPorts is required at $port_bin. Install it from https://www.macports.org/install.php."
  fi
fi

state_dir="$(mktemp -d "${TMPDIR:-/tmp}/macports-brewfile.XXXXXX")"
unresolved_file="$state_dir/unresolved"
gui_file="$state_dir/gui"
install_output_file="$state_dir/install-output"
command_status_file="$state_dir/command-status"
notes_file="$state_dir/notes"
sudo_refresh_sleep_file="$state_dir/sudo-refresh-sleep"
trap cleanup 0 HUP INT TERM

case "$command_name" in
install)
  if "$dry_run"; then
    log "Would run: sudo $port_bin selfupdate"
  else
    start_sudo_session
    if ! run_privileged_port selfupdate; then
      die "MacPorts selfupdate failed. Resolve the error above, then rerun macports-brewfile."
    fi
  fi

  for brewfile in "$@"; do
    run_brewfile "$brewfile"
  done
  ;;
refresh-fallbacks)
  run_all_fallbacks
  ;;
update)
  if "$dry_run"; then
    log "Would run: sudo $port_bin selfupdate"
    log "Would run: sudo $port_bin upgrade outdated"
  else
    start_sudo_session
    if ! run_privileged_port selfupdate; then
      die "MacPorts selfupdate failed. Resolve the error above, then rerun macports-brewfile."
    fi
    if ! run_privileged_port upgrade outdated; then
      die "MacPorts upgrade failed. Resolve the error above, then rerun macports-update."
    fi
  fi

  run_all_fallbacks
  ;;
esac

print_summary
if ! "$dry_run"; then
  print_install_notes
fi
