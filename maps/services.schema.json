{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeffbax/brew-port/schema/services.schema.json",
  "title": "brew-port imported services",
  "type": "object",
  "required": ["version", "services"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": [
        "token",
        "formula",
        "source",
        "port",
        "executable",
        "arguments",
        "keep_alive",
        "environment",
        "working_directory",
        "overrides"
      ],
      "additionalProperties": false,
      "properties": {
        "token": { "$ref": "#/$defs/token" },
        "formula": { "$ref": "#/$defs/token" },
        "source": {
          "type": "object",
          "required": ["version", "generated_date"],
          "additionalProperties": false,
          "properties": {
            "version": { "$ref": "#/$defs/string" },
            "generated_date": { "$ref": "#/$defs/string" }
          }
        },
        "port": { "$ref": "#/$defs/token" },
        "executable": { "$ref": "#/$defs/relativePath" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        },
        "keep_alive": { "$ref": "#/$defs/keepAlive" },
        "environment": { "$ref": "#/$defs/environment" },
        "working_directory": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/absolutePath" }
          ]
        },
        "homebrew_label": { "$ref": "#/$defs/label" },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable": { "$ref": "#/$defs/relativePath" },
            "arguments": {
              "type": "array",
              "items": { "$ref": "#/$defs/string" }
            },
            "keep_alive": { "$ref": "#/$defs/keepAlive" },
            "environment": { "$ref": "#/$defs/environment" },
            "working_directory": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/absolutePath" }
              ]
            },
            "stdout_path": { "$ref": "#/$defs/absolutePath" },
            "stderr_path": { "$ref": "#/$defs/absolutePath" }
          }
        }
      }
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+_.@-]*$"
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@-]*$"
    },
    "string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F]*$"
    },
    "relativePath": {
      "type": "string",
      "allOf": [
        { "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]*$" },
        { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } }
      ]
    },
    "absolutePath": {
      "type": "string",
      "allOf": [
        { "pattern": "^/[^\\u0000-\\u001F]*$" },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } }
      ]
    },
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/string" }
    },
    "keepAlive": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "always": { "type": "boolean" },
        "successful_exit": { "type": "boolean" }
      }
    }
  }
}
