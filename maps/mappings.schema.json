{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeffbax/brew-port/schema/mappings.schema.json",
  "title": "brew-port mappings",
  "type": "object",
  "required": ["version", "mappings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "mappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "required": ["kind", "token", "action"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["brew", "cask"] },
        "token": { "type": "string", "minLength": 1 },
        "action": { "enum": ["port", "skip", "fallback", "fallback-root", "manual"] },
        "target": { "type": "string" },
        "note": { "type": "string" },
        "detect": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(~/|/)" }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["x86_64", "arm64"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "port" } } },
          "then": {
            "required": ["target"],
            "properties": { "target": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "action": { "enum": ["fallback", "fallback-root"] } } },
          "then": {
            "required": ["target", "architectures"],
            "properties": { "target": { "pattern": "^fallbacks/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.sh$" } }
          }
        },
        {
          "if": { "properties": { "action": { "const": "manual" } } },
          "then": {
            "required": ["detect"],
            "properties": { "kind": { "const": "cask" } },
            "not": { "required": ["target"] }
          },
          "else": { "not": { "required": ["detect"] } }
        }
      ]
    }
  }
}
